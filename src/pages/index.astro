---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';

const schemaData = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Ing. Petr Novák - Energetický specialista",
  "image": "https://prukaz.info/images/solarni-panely.jpg",
  "@id": "https://prukaz.info",
  "url": "https://prukaz.info",
  "telephone": "+420 724 697 426",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Brno",
    "addressRegion": "Jihomoravský kraj",
    "addressCountry": "CZ"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 49.19506,
    "longitude": 16.606837
  },
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": [
      "Monday",
      "Tuesday",
      "Wednesday",
      "Thursday",
      "Friday"
    ],
    "opens": "08:00",
    "closes": "17:00"
  },
  "sameAs": [],
  "priceRange": "$$",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Energetické služby",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Průkaz energetické náročnosti budovy (PENB)",
          "description": "Zpracování energetických průkazů pro rodinné i bytové domy."
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Nová zelená úsporám",
          "description": "Odborné posudky pro dotační programy."
        }
      }
    ]
  }
};
---

<Layout
	title="PENB a energetický specialista | Ing. Petr Novák"
	description="Potřebujete průkaz energetické náročnosti budovy (PENB)? Nabízím rychlé a profesionální zpracování energetických štítků, auditů a poradenství pro dotace po celé ČR."
	canonicalURL="/"
	schemaData={schemaData}
>
	<Header />

	<main>
		<!-- Hero Section -->
		<section class="hero-section py-12 md:py-20">
			<div class="wrapper">
				<div class="grid md:grid-cols-2 gap-8 md:gap-12 items-center">
					<div class="stack" style="--space: 2rem;">
						<div class="badge bg-green-100 text-green-800 px-4 py-1 rounded-full text-sm font-bold inline-block w-fit uppercase tracking-wide">
							Odbornost a zkušenost
						</div>
						<h1 class="text-4xl md:text-5xl font-bold leading-tight">
							Snižte náklady na energie s <span class="text-green-700">profesionálem</span>
						</h1>
						<p class="text-xl text-gray-600 leading-relaxed">
							Zpracuji pro vás Průkaz energetické náročnosti budovy (PENB) rychle, kvalitně a za férovou cenu. Pomohu vám se zorientovat v dotačních titulech.
						</p>
						<div class="cluster" style="--gutter: 1rem;">
							<a href="/sluzby" class="bg-green-700 text-white px-8 py-4 rounded-lg font-bold hover:bg-green-800 transition-colors">Naše služby</a>
							<a href="#kontakt" class="border-2 border-green-700 text-green-700 px-8 py-4 rounded-lg font-bold hover:bg-green-50 transition-colors">Kontaktujte mě</a>
						</div>
					</div>
					<div class="relative">
						<div class="bg-gray-200 rounded-2xl aspect-video overflow-hidden shadow-2xl">
							<img src="/images/solarni-panely.jpg" alt="Rodinný dům s fotovoltaickými solárními panely na střeše jako ukázka úspory energie" class="w-full h-full object-cover" loading="eager" />
						</div>
						<div class="absolute -bottom-6 -right-6 bg-white p-4 rounded-xl shadow-lg hidden lg:block border border-gray-100">
							<div class="flex items-center gap-3">
								<div class="bg-green-100 p-2 rounded-lg text-green-700">
									<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
									</svg>
								</div>
								<div>
									<p class="text-sm font-bold text-gray-900">Certifikovaný specialista</p>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Co je to PENB -->
		<section class="bg-gray-50 py-12 md:py-20">
			<div class="wrapper stack" style="--space: 3rem;">
				<div class="max-w-3xl">
					<h2 class="text-2xl md:text-3xl font-bold mb-4 md:mb-6">Co je to PENB a proč ho potřebujete?</h2>
					<p class="text-lg text-gray-600">
						Průkaz energetické náročnosti budovy (PENB) informuje o energetické náročnosti budovy. Je nezbytným dokumentem při prodeji, pronájmu nebo výstavbě nemovitosti.
					</p>
				</div>

				<div class="grid md:grid-cols-3 gap-8">
					{[
						{ title: 'Při prodeji', desc: 'Zákonná povinnost pro majitele nemovitosti při jejím prodeji.' },
						{ title: 'Při pronájmu', desc: 'Od roku 2016 je povinný i při pronájmu bytů a domů.' },
						{ title: 'Při výstavbě', desc: 'Nezbytná součást projektové dokumentace pro stavební povolení.' }
					].map(item => (
						<div class="bg-white p-8 rounded-xl shadow-sm stack" style="--space: 1rem;">
							<div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center text-green-700">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
								</svg>
							</div>
							<h3 class="text-xl font-bold">{item.title}</h3>
							<p class="text-gray-600">{item.desc}</p>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- Sekce Kontrola Vytápění - Druhá část podnikání (Hodně viditelná) -->
		<section class="py-12 md:py-20 bg-gradient-to-br from-green-50 to-emerald-100 border-y border-green-100">
			<div class="wrapper">
				<div class="grid md:grid-cols-12 gap-8 md:gap-12 items-center">
					<div class="md:col-span-7 stack" style="--space: 1.5rem;">
						<div class="badge bg-green-200 text-green-900 px-4 py-1 rounded-full text-xs font-bold inline-block w-fit uppercase tracking-wide">
							Naše další specializace
						</div>
						<h2 class="text-3xl md:text-4xl font-bold text-gray-900 leading-tight">
							Provádíme také zákonné <span class="text-green-700">kontroly systémů vytápění</span>
						</h2>
						<p class="text-lg text-gray-700 leading-relaxed">
							Jako druhou klíčovou část našeho podnikání zajišťujeme profesionální a zákonem předepsané kontroly otopných soustav, kotlů a klimatizačních zařízení. Pomáháme vám plnit legislativní povinnosti a zároveň optimalizovat spotřebu tepla ve vašich objektech.
						</p>
						<ul class="space-y-3 text-gray-700 font-medium">
							<li class="flex items-center gap-3">
								<svg class="h-5 w-5 text-green-600 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
									<path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
								</svg>
								Splnění zákonné povinnosti (dle zákona 406/2000 Sb.)
							</li>
							<li class="flex items-center gap-3">
								<svg class="h-5 w-5 text-green-600 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
									<path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
								</svg>
								Snížení spotřeby a nákladů na vytápění
							</li>
							<li class="flex items-center gap-3">
								<svg class="h-5 w-5 text-green-600 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
									<path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
								</svg>
								Zpracování oprávněným energetickým specialistou
							</li>
						</ul>
						<div class="pt-2">
							<a
								href="https://www.kontrola-systemu-vytapeni.cz/"
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex items-center gap-3 bg-green-700 text-white px-8 py-4 rounded-xl font-bold hover:bg-green-800 transition-colors shadow-md hover:shadow-lg"
							>
								Přejít na kontrola-systemu-vytapeni.cz
							</a>
						</div>
					</div>
					<div class="md:col-span-5 relative">
						<div class="bg-white rounded-3xl p-6 shadow-xl border border-green-100 flex flex-col justify-between aspect-square">
							<div class="stack" style="--space: 1.25rem;">
								<div class="w-16 h-16 bg-green-100 rounded-2xl flex items-center justify-center text-green-700">
									<svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
										<path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
									</svg>
								</div>
								<h3 class="text-2xl font-bold text-gray-900 leading-tight">Máte zájem o odbornou kontrolu kotle či klimatizace?</h3>
								<p class="text-gray-600">
									Navštivte náš specializovaný web a zjistěte více o legislativních lhůtách, průběhu kontroly i cenách.
								</p>
							</div>
							<div class="border-t border-gray-100 pt-6">
								<a
									href="https://www.kontrola-systemu-vytapeni.cz/"
									target="_blank"
									rel="noopener noreferrer"
									class="text-green-700 font-bold flex items-center gap-2 transition-all text-lg"
								>
									Zjistit podrobnosti o vytápění
								</a>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Proč si vybrat mě -->
		<section class="py-12 md:py-20">
			<div class="wrapper">
				<div class="bg-green-700 rounded-3xl p-8 md:p-12 text-white stack" style="--space: 2rem;">
					<h2 class="text-2xl md:text-3xl font-bold">Proč spolupracovat právě se mnou?</h2>
					<ul class="grid sm:grid-cols-2 gap-x-12 gap-y-6" style="--space: 1.5rem;">
						{[
							'Individuální a férový přístup',
							'Dlouholetá praxe v oboru',
							'Rychlé zpracování do 5-7 pracovních dnů',
							'Certifikace Ministerstva průmyslu a obchodu'
						].map(item => (
							<li class="flex items-center gap-4">
								<div class="bg-green-600 rounded-full p-1 shrink-0">
									<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
										<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
									</svg>
								</div>
								<span class="text-lg">{item}</span>
							</li>
						))}
					</ul>
				</div>
			</div>
		</section>
	</main>

	<Contact />
	<Footer />
</Layout>

<style>
</style>
